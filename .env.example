# Copy to `.env` and adjust. Every value is optional — the defaults run fine
# locally.

# Storage. Swap to Postgres for production:
#   postgresql+psycopg://user:password@localhost:5432/bdn
BDN_DATABASE_URL=sqlite:///./bdn.db

# Auth. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BDN_SECRET_KEY=change-me-before-you-deploy-anywhere

BDN_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Domain rules
BDN_DONOR_LOCK_DAYS=120
BDN_REQUEST_TTL_HOURS=6

# Escalation tiers: minutes elapsed -> search radius in km
BDN_ESCALATION_TIERS_MINUTES=[0,15,30]
BDN_ESCALATION_RADII_KM=[5,15,50]
BDN_CAREGIVER_ESCALATION_MINUTES=30
